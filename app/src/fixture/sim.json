   {
    "task_id": "t_c2",
    "proposition": "Should a claim that times out be retried by the same worker or handed to another?",
    "homogeneous": false,
    "phase": "round 2",
    "seats": [
     {
      "role": "strategist",
      "family": "claude"
     },
     {
      "role": "red-team",
      "family": "openai"
     },
     {
      "role": "architect",
      "family": "gemini"
     }
    ],
    "stances": [
     {
      "role": "strategist",
      "answered": true,
      "text": "Hand it to another worker. The first one may be the reason it timed out."
     },
     {
      "role": "red-team",
      "answered": true,
      "text": "The same worker retrying hides a stuck worker. Hand it on, and count the hand-offs."
     },
     {
      "role": "architect",
      "answered": true,
      "text": "Retry once in place, then hand on. A hand-off costs a round trip."
     }
    ],
