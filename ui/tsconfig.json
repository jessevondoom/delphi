{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "paths": {
      "react-devtools-core": [
        "./src/devtools-stub.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "dev/preview-sim.ts",
    "dev/preview-daemon.ts",
    "dev/sketch-panes.ts"
  ]
}