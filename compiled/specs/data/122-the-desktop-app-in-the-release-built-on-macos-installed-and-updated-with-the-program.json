  "summary": {
    "kind": "quote",
    "span": {
      "end": 2175,
      "end_line": 23,
      "line": 23,
      "start": 1863
    },
    "text": "Today `Delphi.app` exists only where someone ran `app/dev/build.sh`. The program (`delphi`) and its console (`delphi-ui`) are built by the release workflow, published with a checksum and an attestation, installed by `install.sh` and replaced by `delphi update`. This spec puts the app on the same path, on macOS:"
  }
