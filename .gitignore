# Delphi source repository (the install source; D-03).
# Delphi itself never writes into a repository: all runtime state lives in $DELPHI_HOME
# (specs/006 §3.1), so there are no Delphi runtime paths to ignore here.

# Rust build output
/target/

# Secrets and local credentials (never commit)
.env
.env.*
!.env.example

# Merge leftovers and scratch
*.upstream-*
*.tmp
scratch/

# OS artifacts
.DS_Store
Thumbs.db
