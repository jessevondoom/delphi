{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jessevondoom/delphi/schemas/episode.schema.json",
  "title": "Delphi Episode Record Frontmatter",
  "description": "The YAML frontmatter of missions/<mission-id>/traces/<role>-<task-id>.md parsed to JSON (spec 065). Stamped deterministically by delphi-engine trace harvesting.",
  "type": "object",
  "required": [
    "id",
    "title",
    "author",
    "role",
    "timestamp",
    "kind",
    "source_type",
    "confidence",
    "status",
    "mission",
    "session_id",
    "task_id",
    "outcome"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ep-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9_-]+$",
      "description": "Unique episode identifier."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Canonical role ID of author."
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Canonical role ID."
    },
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])(T\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?Z)?$"
    },
    "kind": {
      "const": "episode"
    },
    "source_type": {
      "enum": [
        "user_ratified",
        "internal_empirical",
        "internal_generated",
        "federated_verified",
        "federated_peer",
        "external_untrusted"
      ]
    },
    "confidence": {
      "enum": ["verified", "high", "medium", "low"]
    },
    "status": {
      "enum": ["active", "superseded", "stale", "retired"]
    },
    "valid_until": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])(T\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?Z)?$"
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "skills_used": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tools_invoked": {
      "type": "array",
      "items": { "type": "string" }
    },
    "outcome": {
      "enum": ["success", "failure", "resolved_after_failure", "rejected_gate"]
    },
    "error_fingerprints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "target_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
