{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jessevondoom/delphi/schemas/bundle.schema.json",
  "title": "Delphi org bundle manifest (bundle.toml, schema 1)",
  "description": "Validate the TOML parsed to JSON. `delphi bundle validate` is authoritative and also checks files, secrets and signatures (specs/023 §10; crates/delphi-bundle/src/manifest.rs). A bundle states no trust and grants nothing: keys such as tier, trust, permissions, hooks, env, secrets, mcp_servers and credentials are refused anywhere in the file, and unknown keys are errors.",
  "type": "object",
  "required": ["bundle", "publisher"],
  "properties": {
    "bundle": {
      "type": "object",
      "required": ["schema", "name", "org", "version", "title", "description", "license", "audience", "review_by"],
      "properties": {
        "schema": { "const": 1 },
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
        "org": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "version": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$", "description": "Semver." },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 200, "not": { "pattern": "\\]\\(" }, "$comment": "Plain text: no Markdown links." },
        "license": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "pattern": "^https://" },
        "audience": { "enum": ["org", "team", "project", "person"] },
        "review_by": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "A date. Past it, every surface shows the bundle as stale and packaging refuses it." },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "description": "BCP 47." }
      },
      "additionalProperties": false
    },
    "compat": {
      "type": "object",
      "properties": {
        "delphi": { "type": "string", "description": "A semver requirement on the running program, for example `>=0.2.0`." },
        "bundle_schema": { "const": 1, "description": "Must equal bundle.schema." }
      },
      "additionalProperties": false
    },
    "publisher": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "contact": { "type": "string" },
        "did": { "type": "string", "pattern": "^did:key:z" },
        "predecessors": { "type": "array", "items": { "type": "string", "pattern": "^did:key:z" } }
      },
      "additionalProperties": false
    },
    "applies_to": {
      "type": "object",
      "properties": {
        "repos": { "type": "array", "items": { "type": "string" } },
        "tech": { "type": "array", "items": { "type": "string" } },
        "paths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "description": "Each `true` needs a directory of that name.",
      "properties": {
        "knowledge": { "type": "boolean" },
        "skills": { "type": "boolean" },
        "agents": { "type": "boolean" },
        "behavior": { "type": "boolean" },
        "evals": { "type": "boolean" },
        "vectors": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "description": "One table per bundle agent, each with an `agents/<name>.md`.",
      "additionalProperties": {
        "type": "object",
        "required": ["role"],
        "properties": { "role": { "$ref": "#/$defs/role" } },
        "additionalProperties": false
      }
    },
    "touches": {
      "type": "object",
      "properties": {
        "roles": { "type": "array", "items": { "$ref": "#/$defs/role" } },
        "connectors": { "type": "array", "items": { "type": "string" } },
        "network": { "const": false, "description": "`true` is refused in schema 1." }
      },
      "additionalProperties": false
    },
    "overlays": {
      "type": "object",
      "properties": {
        "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}@.+$", "description": "`name@<semver requirement>`." } },
        "supersedes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "role": { "enum": ["orchestrator", "builder", "architect", "investigator", "scout", "strategist", "red-team", "writer", "integrator", "librarian", "validator"] }
  }
}
