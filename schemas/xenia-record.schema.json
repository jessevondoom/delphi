{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jessevondoom/delphi/schemas/xenia-record.schema.json",
  "title": "Xenia record frontmatter (schema 1)",
  "description": "The YAML frontmatter of records/<kind>/<id>.md, parsed to JSON (specs/012 §2-§5). Unknown keys are rejected because an ignored key is a smuggling channel; no key may state a trust tier (tier, trust, trust_class, source_type, endorsed, verified_by_org). The verifier also checks the path, the sidecar, the signature, size limits, string hygiene and dates (specs/012 §6); this schema covers shape only.",
  "type": "object",
  "required": ["xenia", "id", "kind", "rev", "org", "store", "author", "author_role", "title", "summary", "visibility", "created", "updated", "source_ceiling", "status", "redaction", "body_kind"],
  "properties": {
    "xenia": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$", "description": "ULID; equals the file name." },
    "kind": { "enum": ["memory", "endorsement", "tombstone", "bundle"], "description": "Equals the directory name." },
    "rev": { "type": "integer", "minimum": 1 },
    "org": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
    "store": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
    "author": { "type": "string", "pattern": "^did:key:z", "description": "Equals the sidecar kid." },
    "author_handle": { "type": "string", "description": "Display only." },
    "author_role": { "enum": ["operator", "orchestrator", "architect", "builder", "investigator", "scout", "strategist", "red-team", "writer", "messenger", "integrator"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500, "not": { "pattern": "\\]\\(" } },
    "tags": { "type": "array", "maxItems": 12, "items": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" } },
    "visibility": { "const": "org" },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "source_ceiling": { "enum": ["user_ratified", "internal_empirical", "internal_generated", "federated_verified", "federated_peer", "external_untrusted"] },
    "confidence": { "enum": ["low", "medium", "high", "verified"] },
    "status": { "enum": ["active", "superseded", "withdrawn"] },
    "supersedes": { "type": ["string", "null"], "description": "`id@rev`." },
    "review_by": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "pointers": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/pointer" } },
    "evidence": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/pointer" } },
    "related": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
    "redaction": {
      "type": "object",
      "required": ["scanner", "scanner_version", "result", "content_hash"],
      "properties": {
        "scanner": { "type": "string" },
        "scanner_version": { "type": "string" },
        "result": { "const": "passed" },
        "content_hash": { "type": "string", "pattern": "^blake3:" }
      },
      "additionalProperties": false
    },
    "body_kind": { "enum": ["markdown", "none"] },

    "memory_type": { "enum": ["finding", "decision", "gotcha", "how-to"] },
    "applies_to": {
      "type": "object",
      "properties": {
        "repos": { "type": "array", "items": { "type": "string" } },
        "tech": { "type": "array", "items": { "type": "string" } },
        "paths": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "verified_by": { "enum": ["none", "review", "test", "ci"] },

    "target": { "type": "string", "description": "endorsement: `<id>@<rev>`; tombstone: `<id>`." },
    "target_hash": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
    "verdict": { "enum": ["endorse", "dispute", "withdraw"] },
    "scope": { "type": "array", "items": { "type": "string" } },
    "note": { "type": "string", "maxLength": 300 },
    "checked": { "type": "array", "items": { "enum": ["target-open", "evidence-open", "summary-matches"] } },
    "action": { "enum": ["withdraw", "restore"] },
    "reason": { "enum": ["superseded", "mistake", "sensitive", "departed", "other"] },

    "bundle_name": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" },
    "bundle_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$", "maxLength": 32 },
    "bundle_hash": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$", "description": "blake3 of the bundle's files.json: the identity across transports (specs/023 §3.4)." },
    "tree": {
      "allOf": [{ "$ref": "#/$defs/pointer" }],
      "properties": { "scheme": { "const": "git" }, "locator": { "pattern": "^https://[^#]+#[^#]+$" }, "pin": { "properties": { "kind": { "enum": ["git-tree", "git-commit"] }, "value": { "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" } } } },
      "description": "A git pointer over https to the bundle tree; `#.` is the repository root (specs/027 §4.3)."
    },
    "touches": {
      "type": "object",
      "required": ["roles", "connectors"],
      "properties": {
        "roles": { "type": "array", "maxItems": 16, "items": { "enum": ["operator", "orchestrator", "architect", "builder", "investigator", "scout", "strategist", "red-team", "writer", "messenger", "integrator"] } },
        "connectors": { "type": "array", "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" } }
      },
      "additionalProperties": false
    },
    "compat": {
      "type": "object",
      "required": ["bundle_schema"],
      "properties": { "delphi": { "type": "string", "maxLength": 64 }, "bundle_schema": { "const": 1 } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "memory" } } },
      "then": {
        "required": ["memory_type", "review_by"],
        "not": { "anyOf": [{ "required": ["bundle_name"] }, { "required": ["bundle_version"] }, { "required": ["bundle_hash"] }, { "required": ["tree"] }, { "required": ["touches"] }, { "required": ["compat"] }, { "required": ["target"] }, { "required": ["target_hash"] }, { "required": ["verdict"] }, { "required": ["scope"] }, { "required": ["checked"] }, { "required": ["action"] }, { "required": ["reason"] }] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "endorsement" } } },
      "then": {
        "required": ["target", "target_hash", "verdict"],
        "properties": { "target": { "pattern": "^[0-9A-HJKMNP-TV-Z]{26}@[1-9][0-9]*$" }, "note": { "maxLength": 300 } },
        "not": { "anyOf": [{ "required": ["bundle_name"] }, { "required": ["bundle_version"] }, { "required": ["bundle_hash"] }, { "required": ["tree"] }, { "required": ["touches"] }, { "required": ["compat"] }, { "required": ["memory_type"] }, { "required": ["applies_to"] }, { "required": ["verified_by"] }, { "required": ["action"] }, { "required": ["reason"] }] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "endorsement" }, "verdict": { "const": "dispute" } }, "required": ["kind", "verdict"] },
      "then": { "required": ["note"] }
    },
    {
      "if": { "properties": { "kind": { "const": "tombstone" } } },
      "then": {
        "required": ["target", "action", "reason"],
        "properties": { "target": { "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }, "note": { "maxLength": 200 } },
        "not": { "anyOf": [{ "required": ["bundle_name"] }, { "required": ["bundle_version"] }, { "required": ["bundle_hash"] }, { "required": ["tree"] }, { "required": ["touches"] }, { "required": ["compat"] }, { "required": ["memory_type"] }, { "required": ["applies_to"] }, { "required": ["verified_by"] }, { "required": ["target_hash"] }, { "required": ["verdict"] }, { "required": ["scope"] }, { "required": ["checked"] }] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "bundle" } } },
      "then": {
        "required": ["bundle_name", "bundle_version", "bundle_hash", "tree", "touches", "compat"],
        "not": { "anyOf": [{ "required": ["memory_type"] }, { "required": ["applies_to"] }, { "required": ["verified_by"] }, { "required": ["target"] }, { "required": ["target_hash"] }, { "required": ["verdict"] }, { "required": ["scope"] }, { "required": ["checked"] }, { "required": ["action"] }, { "required": ["reason"] }] }
      }
    }
  ],
  "$defs": {
    "pointer": {
      "type": "object",
      "required": ["scheme", "locator", "label", "content_type"],
      "properties": {
        "scheme": { "enum": ["git", "https", "xenia", "drive"], "description": "`drive` is accepted by the schema but not publishable in Phase 1." },
        "locator": { "type": "string", "not": { "pattern": "^(file:|/|\\.|[dD][eE][lL][pP][hH][iI]:|[xX][eE][nN][iI][aA]://[cC][aA][pP](/|$))" }, "description": "`delphi://` is refused (use `xenia://`); `xenia://cap/` is reserved for capability URIs and not built." },
        "pin": {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["git-commit", "git-tree", "content-hash", "drive-revision", "none"] },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        },
        "hash": { "type": "string", "pattern": "^blake3:" },
        "range": { "type": "string", "pattern": "^L\\d+-L\\d+$" },
        "label": { "type": "string", "maxLength": 80 },
        "content_type": { "enum": ["text/markdown", "text/plain", "application/pdf", "application/json", "image/png", "other"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "access_hint": { "type": "string", "maxLength": 120 }
      },
      "if": { "properties": { "scheme": { "const": "xenia" } }, "required": ["scheme"] },
      "then": { "properties": { "locator": { "pattern": "^xenia://[a-z]+/[0-9A-HJKMNP-TV-Z]{26}(@[1-9][0-9]{0,8})?$" } } },
      "additionalProperties": false
    }
  }
}
